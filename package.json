{
  "name": "funeng-moniqi",
  "productName": "赋能模拟器",
  "version": "0.4.0",
  "description": "无畏契约职业选手设置库 · 纯信息查询工具，不读写游戏文件",
  "main": "electron/main.js",
  "packageManager": "pnpm@10.17.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "build": {
    "appId": "cn.funeng.moniqi",
    "productName": "赋能模拟器",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "data/**",
      "assets/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icons/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "赋能模拟器"
    }
  }
}
